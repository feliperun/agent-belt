#!/usr/bin/env bash
# work - sessoes de trabalho persistentes em qualquer maquina do tailnet.
#
#   work                            menu interativo com as sessoes de todas as maquinas
#   work ls                         a mesma lista, em texto
#   work <tarefa> [repo]            cria (ou reata) na maquina local
#   work <maquina> <tarefa> [repo]  cria (ou reata) na maquina registrada
#   work attach [-d] <sessao> [maquina]  atacha direto, sem menu
#                                   -d expulsa quem ja estiver atachado
#   work adopt [maquina]            agente aberto fora do tmux: encerra e
#                                   reabre a mesma conversa dentro do tmux
#   work hosts [discover|add|rm|self]   registro de maquinas
#   work doctor                     testa ssh, work e toolchain em cada maquina
#
#   -a|--agent claude|codex|shell   qual agente sobe na sessao (default: claude)
#   -p|--prompt "texto"             primeira instrucao para o agente (so ao criar)
#   --codex / --claude / --shell    atalhos
#
# Maquinas sao identificadas pelo nome oficial do tailnet (macbook-pro,
# felipe-windows, frb-omarchy, ...). Prefixo nao-ambiguo tambem serve.
#
# O mesmo script roda em macOS, Linux e Windows (MSYS2) e e, ao mesmo tempo,
# cliente e host: o que muda e se a maquina alvo e ela mesma (executa local) ou
# outra (executa por ssh, chamando o `work` de la).

set -uo pipefail

PROG=${0##*/}
CONFIG="${WORK_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/work/hosts.conf}"
TAB=$(printf '\t')
# Separador de campo do `ls-raw`. Nao pode ser tab (o `read` do bash colapsa
# sequencias de espaco em branco, e um campo vazio desalinharia a linha) nem um
# caractere de controle como \037: sob locale C o tmux sanitiza nao-imprimivel
# para "_" na saida do -F, e so no destino remoto -- bug dificil de achar. O
# caminho da sessao e o ultimo campo, entao um "|" dentro dele nao atrapalha.
SEP='|'
SSH_TIMEOUT="${WORK_SSH_TIMEOUT:-6}"
# Sem BatchMode em sessao interativa: atachar pode precisar de passphrase.
SSH_BATCH=(-o BatchMode=yes -o ConnectTimeout="$SSH_TIMEOUT" -o StrictHostKeyChecking=accept-new)
SSH_TTY=(-t -o ConnectTimeout="$SSH_TIMEOUT" -o StrictHostKeyChecking=accept-new)

die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }

case "$(uname -s)" in
  MSYS*|MINGW*|CYGWIN*) PLATFORM=windows ;;
  Darwin)               PLATFORM=mac ;;
  *)                    PLATFORM=linux ;;
esac

# Mesma historia do work-session: TERM que veio do cliente pode nao existir no
# terminfo desta maquina, e ai o `tmux attach` morre.
if command -v infocmp >/dev/null 2>&1; then
  [ -n "${TERM:-}" ] && infocmp "$TERM" >/dev/null 2>&1 || TERM=xterm-256color
fi
export TERM="${TERM:-xterm-256color}"

[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
[ "$PLATFORM" = mac ] && [ -d /opt/homebrew/bin ] && PATH="/opt/homebrew/bin:$PATH"
# O ssh do Windows nao esta no PATH do login shell do MSYS2. Sem isto, este
# script funciona como host mas nao como cliente: toda chamada remota falha em
# silencio e o `ls` mostra so as sessoes locais.
[ "$PLATFORM" = windows ] && [ -d "/c/Windows/System32/OpenSSH" ] && PATH="$PATH:/c/Windows/System32/OpenSSH"
export PATH

# ---------------------------------------------------------------- registro --

# O tmux que roda no destino precisa saber que o terminal que chegou pelo SSH
# aceita OSC 52. No Omarchy isso vem do tmux.conf local, mas um attach remoto
# entra direto no tmux da outra maquina; portanto a configuracao do cliente
# nunca chega ao servidor remoto. Sem a feature `clipboard`, o tmux do Mac,
# por exemplo, nao emite o OSC 52 quando copiamos no copy-mode.
tmux_clipboard() {
  tmux set-option -g set-clipboard on 2>/dev/null || return 0
  tmux set-option -g allow-passthrough on 2>/dev/null || true
  # Roda (trackpad, mouse ou o knob do minikeyboard) rola o historico no
  # copy-mode e sai sozinha no fim; sem isto o terminal traduz a roda em setas
  # e o agente navega pelo historico do prompt. Option+arrastar mantem a
  # selecao nativa do terminal.
  tmux set-option -g mouse on 2>/dev/null || true

  # `terminal-features` e uma opcao array. So acrescenta a regra generica uma
  # vez para nao fazer o valor crescer a cada `work attach`.
  if ! tmux show-options -gqv terminal-features 2>/dev/null |
      grep -qE '^\*:.*clipboard'; then
    tmux set-option -as terminal-features ',*:clipboard' 2>/dev/null || true
  fi
}

NAMES=(); TARGETS=(); KINDS=(); SELF_NAME=""

load_config() {
  NAMES=(); TARGETS=(); KINDS=(); SELF_NAME=""
  [ -f "$CONFIG" ] || return 0
  local kw a b c
  while read -r kw a b c || [ -n "$kw" ]; do
    case "$kw" in
      ''|'#'*) continue ;;
      self)    SELF_NAME="$a" ;;
      host)    [ -n "$a" ] && [ -n "$b" ] || continue
               NAMES+=("$a"); TARGETS+=("$b"); KINDS+=("${c:-posix}") ;;
    esac
  done < "$CONFIG"
}

tailscale_bin() {
  local c
  c=$(command -v tailscale 2>/dev/null) && { printf '%s' "$c"; return 0; }
  for c in /Applications/Tailscale.app/Contents/MacOS/Tailscale \
           "/c/Program Files/Tailscale/tailscale.exe" \
           /usr/bin/tailscale; do
    [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# nome<TAB>so de cada maquina do tailnet, a propria incluida
tailnet_rows() {
  local ts; ts=$(tailscale_bin) || return 1
  "$ts" status 2>/dev/null | awk -v t="$TAB" '$1 ~ /^100\./ && NF >= 4 { print $2 t $4 }'
}

tailnet_self() {
  local ts; ts=$(tailscale_bin) || return 1
  "$ts" status --self=true --peers=false 2>/dev/null | awk '$1 ~ /^100\./ { print $2; exit }'
}

# Qual entrada do registro e esta maquina. Ordem: WORK_SELF, linha `self` do
# arquivo, nome no tailnet, hostname.
detect_self() {
  [ -n "${WORK_SELF:-}" ] && { printf '%s' "$WORK_SELF"; return 0; }
  [ -n "$SELF_NAME" ] && { printf '%s' "$SELF_NAME"; return 0; }
  local cand i
  cand=$(tailnet_self 2>/dev/null)
  if [ -n "$cand" ]; then
    for ((i = 0; i < ${#NAMES[@]}; i++)); do
      [ "${NAMES[$i]}" = "$cand" ] && { printf '%s' "$cand"; return 0; }
    done
  fi
  cand=$(hostname 2>/dev/null | cut -d. -f1 | tr 'A-Z' 'a-z')
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    [ "$(printf '%s' "${NAMES[$i]}" | tr 'A-Z' 'a-z')" = "$cand" ] && { printf '%s' "${NAMES[$i]}"; return 0; }
  done
  return 1
}

# indice da maquina, aceitando nome exato ou prefixo nao-ambiguo
resolve_host() {
  local tok="$1" i hits=()
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    [ "${NAMES[$i]}" = "$tok" ] && { printf '%s' "$i"; return 0; }
  done
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    case "${NAMES[$i]}" in "$tok"*) hits+=("$i") ;; esac
  done
  if [ "${#hits[@]}" -eq 1 ]; then printf '%s' "${hits[0]}"; return 0; fi
  return 1
}

is_self() { [ "${NAMES[$1]}" = "$SELF" ]; }

# Como invocar o `work` da maquina $1 do outro lado do ssh. Sai sem aspas de
# proposito: o sshd do Windows embrulha o comando em `powershell -c`, onde
# quoting de shell nao vale nada -- entao todo token e simples e seguro.
remote_prefix() {
  local i="$1" user
  case "${KINDS[$i]}" in
    msys)
      user=${TARGETS[$i]%@*}
      printf 'C:\\msys64\\usr\\bin\\bash.exe -l /c/Users/%s/.local/bin/work' "$user"
      ;;
    *) printf '%s' '$HOME/.local/bin/work' ;;
  esac
}

# --------------------------------------------------------------- validacao --

valid_slug() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
# Barra invertida fica de fora de proposito: C:\dev\x atravessando o powershell
# e fonte de bug. Use o nome (coreum) ou C:/dev/coreum.
valid_repo() { case "$1" in ''|*[!A-Za-z0-9._/:~-]*) return 1 ;; *) return 0 ;; esac; }

# ----------------------------------------------------------------- sessoes --

# Qual agente esta numa sessao que o `work` nao criou. A marca @work_agent so
# existe em sessao nascida daqui; para as outras, quem responde e o processo em
# primeiro plano do pane. Nao da para confiar no nome do processo: o binario do
# claude e versionado e aparece como "2.1.269".
infer_agent() {
  local tty="$1" cmd="$2" args=""
  [ -n "$tty" ] && args=$(ps -t "${tty#/dev/}" -o args= 2>/dev/null)
  # [c]laude para o proprio grep nao entrar na conta.
  if printf '%s\n' "$args" | grep -qE '(^|[ /])[c]laude( |$)'; then printf 'claude~'; return; fi
  if printf '%s\n' "$args" | grep -qE '(^|[ /])[c]odex( |$)';  then printf 'codex~';  return; fi
  case "$cmd" in
    bash|zsh|sh|fish|pwsh|powershell) printf 'shell' ;;
    '')                               printf -- '-' ;;
    *)                                printf '%s' "$cmd" ;;
  esac
}

# Agente rodando fora do tmux (aberto direto num terminal) nao pode ser
# atachado -- processo de console nao migra para dentro do tmux depois de
# comecar. Mas contar quantos existem evita voce procurar uma sessao que nunca
# vai aparecer na lista.
# No Windows o agente que roda dentro do tmux tambem e um .exe nativo, e o msys
# nao mostra a parentela dele: pelo `ps -W` os dois casos sao identicos. O que
# separa e o horario de inicio -- o claude.exe lancado por um pane nasce no
# mesmo segundo que o winpty que o lancou. Bater por segundo erra para o lado
# seguro: na duvida, nao oferece matar um agente que ja esta no tmux.
win_agents_outside() {
  local intimes winpid stime rest inside total
  # Trava barata primeiro: se ha pane de agente para cada .exe, nada esta
  # solto. Cobre o caso comum de um agente so e nunca oferece matar o que
  # esta no tmux.
  inside=$(tmux list-panes -a -F '#{pane_current_command}' 2>/dev/null | grep -cE '^(winpty|claude|codex)$')
  total=$(ps -W 2>/dev/null | grep -cE '[c]laude\.exe|[c]odex\.exe')
  [ "${total:-0}" -le "${inside:-0}" ] && return 0
  # Comparacao por minuto, nao por segundo: o .exe nasce um instante depois do
  # winpty que o lancou (16:58:34 -> 16:58:35), e exigir o mesmo segundo
  # marcava como solto um agente que estava dentro do tmux.
  intimes=$(ps -f 2>/dev/null | awk '/[w]inpty|[c]laude|[c]odex/ { print substr($5, 1, 5) }' | sort -u)
  ps -W 2>/dev/null | grep -E '[c]laude\.exe|[c]odex\.exe' |
  while read -r _ _ _ winpid _ _ stime rest; do
    case "$winpid" in ''|*[!0-9]*) continue ;; esac
    printf '%s\n' "$intimes" | grep -qx -- "$(printf '%s' "$stime" | cut -c1-5)" && continue
    printf '%s %s\n' "$winpid" "$rest"
  done
}

agents_outside() {
  local total=0 inside=0 panes agentes t
  if [ "$PLATFORM" = windows ]; then
    printf '%s' "$(win_agents_outside | grep -c .)"
    return
  fi
  # Contar processo nao serve: um agente sobe uma penca de filhos (MCP, tools).
  # O que se quer saber e quantos *terminais* tem agente rodando, entao a
  # unidade e o tty -- e os que nao tem tty nenhum ficam de fora.
  # O ps do macOS imprime "s001" onde o tmux diz "/dev/ttys001": normaliza os
  # dois lados tirando /dev/ e o prefixo tty.
  # Fora da conta: `claude bg-spare` (processo auxiliar do daemon) e o binario
  # versionado com --session-id (worker que o proprio Claude Code sobe em
  # background). Nenhum dos dois e sessao de ninguem.
  panes=$(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | sed -e 's|^/dev/||' -e 's|^tty||' | sort -u)
  agentes=$(ps axo tty=,args= 2>/dev/null |
    awk '$1 != "??" && $1 != "?" && !/bg-spare/ && !/\/versions\/[0-9]/ &&
         /(^|[ \/])[c]laude( |$)|(^|[ \/])[c]odex( |$)/ { print $1 }' |
    sed -e 's|^/dev/||' -e 's|^tty||' | sort -u)
  for t in $agentes; do
    printf '%s\n' "$panes" | grep -qx -- "$t" || total=$((total + 1))
  done
  printf '%s' "$total"
}

# Renomear a conversa no claude/codex renomeia a sessao tmux junto. O agente
# publica o proprio nome no titulo do terminal (OSC) e o tmux guarda isso em
# pane_title -- e o unico canal que existe de dentro do agente para fora.
#
# Tres cuidados:
#   - o titulo vem com um glifo de estado na frente ("* fix-windows"), entao
#     so a parte que vira slug interessa;
#   - quando o nome do agente e o mesmo que o `work` deu no --name, nao ha
#     rename nenhum a propagar (seria trocar "coreum-xpto" por "xpto" e perder
#     o repo do nome);
#   - o prefixo do repo fica: "coreum-xpto" renomeado para "bug-impressora"
#     vira "coreum-bug-impressora".
# WORK_NO_RENAME=1 desliga.
sync_session_name() {
  local sess="$1" agent="$2" task="$3" title="$4" novo base
  [ "${WORK_NO_RENAME:-0}" = "1" ] && return 0
  case "$agent" in claude*|codex*) ;; *) return 0 ;; esac
  [ -n "$title" ] || return 0

  # Nome de sessao do tmux nao aceita "." nem ":"; o resto vira traco.
  novo=$(printf '%s' "$title" | tr ' ' '-' | tr -cd 'A-Za-z0-9_-' |
         sed -e 's/^-*//' -e 's/-*$//' | cut -c1-40)
  [ -n "$novo" ] || return 0
  [ "$novo" = "$task" ] && return 0          # e so o --name que nos mesmos demos
  [ "$novo" = "$sess" ] && return 0

  base=""
  [ -n "$task" ] && case "$sess" in *-"$task") base="${sess%-$task}" ;; esac
  [ -n "$base" ] && novo="$base-$novo"
  [ "$novo" = "$sess" ] && return 0
  tmux has-session -t "=$novo" 2>/dev/null && return 0   # nome ja ocupado

  # Sessao antiga nao tem @work_task. Gravar o nome de agora antes de trocar
  # mantem `work <nome-antigo>` funcionando depois do rename -- senao ele nao
  # acharia mais nada e abriria uma segunda sessao no mesmo worktree.
  [ -n "$task" ] || tmux set-option -t "$sess" @work_task "$sess" 2>/dev/null

  tmux rename-session -t "=$sess" "$novo" 2>/dev/null || return 0
  printf '%s' "$novo"
}

ls_raw() {
  local s w c a ag p tty cmd task title novo
  tmux list-sessions -F \
    "#{session_name}${SEP}#{session_windows}${SEP}#{session_created}${SEP}#{?session_attached,1,0}${SEP}#{?@work_agent,#{@work_agent},}${SEP}#{session_path}${SEP}#{pane_tty}${SEP}#{pane_current_command}${SEP}#{?@work_task,#{@work_task},}${SEP}#{pane_title}" \
    2>/dev/null |
  while IFS="$SEP" read -r s w c a ag p tty cmd task title; do
    [ -n "$s" ] || continue
    [ -n "$ag" ] || ag=$(infer_agent "$tty" "$cmd")
    novo=$(sync_session_name "$s" "$ag" "$task" "$title")
    [ -n "$novo" ] && s="$novo"
    printf "%s${SEP}%s${SEP}%s${SEP}%s${SEP}%s${SEP}%s\n" "$s" "$w" "$c" "$a" "$ag" "$p"
  done
  printf "#fora${SEP}%s\n" "$(agents_outside)"
}

# ------------------------------------------------------------------ adocao --
#
# Agente que nasceu fora do tmux nao pode ser atachado -- mas a conversa dele
# nao vive no processo. O claude guarda cada sessao em
# ~/.claude/projects/<caminho>/<id>.jsonl, o codex em ~/.codex. Entao da para
# encerrar o processo solto e reabrir a *mesma* conversa dentro do tmux, no
# mesmo diretorio, com --continue. Perde-se o turno em andamento e o
# scrollback; a conversa volta inteira.

# `stat -f` no GNU e "filesystem", nao "formato": tentar o -c antes evita
# receber texto de erro no lugar do epoch (e um ATIVO "?" na tabela).
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || printf 0; }

proc_cwd() {
  local pid="$1"
  [ -r "/proc/$pid/cwd" ] && { readlink "/proc/$pid/cwd"; return; }
  lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
}

# Quando a conversa daquele diretorio foi tocada pela ultima vez. O claude
# troca "/" e "." por "-" no nome da pasta de projeto.
conv_epoch() {
  local dir="$1" slug f
  slug=$(printf '%s' "$dir" | sed 's|[/.]|-|g')
  f=$(ls -t "$HOME/.claude/projects/$slug"/*.jsonl 2>/dev/null | head -1)
  [ -n "$f" ] && file_mtime "$f" || printf 0
}

# Se o processo foi aberto com --resume/--session-id, o id da conversa esta nos
# proprios argumentos e a adocao volta exatamente naquela. Sem isso, so da para
# pedir a mais recente do diretorio (--continue) -- que e a certa quando ha um
# agente so ali, e ambigua quando ha varios.
conv_id() {
  printf '%s' "$1" | sed -nE 's/.*--(resume|session-id)[ =]([0-9a-fA-F-]{36}).*/\2/p' | head -1
}

# Plano B do Windows: processo nativo nao entrega cwd para o msys, entao o
# diretorio sai do registro de conversas do proprio claude.
last_claude_conv() {
  local f d
  f=$(ls -t "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | head -1)
  [ -n "$f" ] || return 1
  # O jsonl guarda o caminho como JSON: C:\\dev\\x. Desescapa e, no Windows,
  # converte para a forma que o tmux e o test -d entendem.
  d=$(grep -o '"cwd":"[^"]*"' "$f" 2>/dev/null | head -1 | sed 's/.*:"//; s/"$//; s|\\\\|\\|g')
  [ -n "$d" ] || return 1
  [ "$PLATFORM" = windows ] && d=$(cygpath -u "$d" 2>/dev/null || printf '%s' "$d")
  printf '%s%s%s' "$d" "$SEP" "$(file_mtime "$f")"
}

# pid|agente|diretorio|epoch -- um por agente rodando fora do tmux
adopt_list() {
  local panes pid tty rest agent dir winpid conv
  if [ "$PLATFORM" = windows ]; then
    conv=$(last_claude_conv) || conv="?${SEP}0"
    win_agents_outside | while read -r winpid rest; do
      agent=claude; case "$rest" in *codex*) agent=codex ;; esac
      printf '%s%s%s%s%s%s\n' "$winpid" "$SEP" "$agent" "$SEP" "$conv" "$SEP"
    done
    return
  fi
  panes=$(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | sed -e 's|^/dev/||' -e 's|^tty||' | sort -u)
  ps axo pid=,tty=,args= 2>/dev/null |
    awk -v s="$SEP" '$2 != "??" && $2 != "?" && !/bg-spare/ && !/\/versions\/[0-9]/ &&
         /(^|[ \/])[c]laude( |$)|(^|[ \/])[c]odex( |$)/ {
           pid = $1; tty = $2; $1 = ""; $2 = ""; sub(/^ +/, ""); print pid s tty s $0 }' |
  while IFS="$SEP" read -r pid tty args; do
    tty=$(printf '%s' "$tty" | sed -e 's|^/dev/||' -e 's|^tty||')
    printf '%s\n' "$panes" | grep -qx -- "$tty" && continue
    agent=claude; case "$args" in *codex*) agent=codex ;; esac
    dir=$(proc_cwd "$pid"); [ -n "$dir" ] || dir="?"
    printf '%s%s%s%s%s%s%s%s%s\n' \
      "$pid" "$SEP" "$agent" "$SEP" "$dir" "$SEP" "$(conv_epoch "$dir")" "$SEP" "$(conv_id "$args")"
  done
}

# Encerra o processo $1 e reabre a conversa dele dentro do tmux. So recebe um
# numero: assim atravessa o `powershell -c` do sshd do Windows sem quoting.
adopt_do() {
  local pid="$1" line agent dir id name base n cmd bin
  case "$pid" in ''|*[!0-9]*) printf 'erro%spid invalido\n' "$SEP"; return 1 ;; esac
  line=$(adopt_list | awk -F"$SEP" -v p="$pid" '$1 == p { print; exit }')
  [ -n "$line" ] || { printf 'erro%sesse processo nao esta mais fora do tmux\n' "$SEP"; return 1; }
  agent=$(printf '%s' "$line" | cut -d"$SEP" -f2)
  dir=$(printf '%s' "$line" | cut -d"$SEP" -f3)
  id=$(printf '%s' "$line" | cut -d"$SEP" -f5)
  [ -d "$dir" ] || { printf 'erro%sdiretorio da conversa desconhecido (%s)\n' "$SEP" "$dir"; return 1; }

  case "$agent" in
    claude) bin=$(command -v claude) || { printf 'erro%sclaude nao esta no PATH\n' "$SEP"; return 1; }
            cmd="$(printf '%q' "$bin") --dangerously-skip-permissions"
            if [ -n "$id" ]; then cmd="$cmd --resume $id"; else cmd="$cmd --continue"; fi ;;
    codex)  bin=$(command -v codex)  || { printf 'erro%scodex nao esta no PATH\n' "$SEP"; return 1; }
            cmd="$(printf '%q' "$bin") --dangerously-bypass-approvals-and-sandbox resume"
            if [ -n "$id" ]; then cmd="$cmd $id"; else cmd="$cmd --last"; fi ;;
    *)      printf 'erro%sagente desconhecido: %s\n' "$SEP" "$agent"; return 1 ;;
  esac
  [ "$PLATFORM" = windows ] && cmd="winpty $cmd"

  # Sem basename aqui: a quebra de linha que ele devolve viraria um traco no
  # fim do nome da sessao.
  base=$(printf '%s' "${dir##*/}" | tr -c 'A-Za-z0-9._-' '-'); name="$base"; n=2
  while tmux has-session -t "=$name" 2>/dev/null; do name="$base-$n"; n=$((n + 1)); done

  if [ "$PLATFORM" = windows ]; then
    /c/Windows/System32/taskkill.exe /PID "$pid" /T /F >/dev/null 2>&1
  else
    kill -TERM "$pid" 2>/dev/null
    for n in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  fi

  tmux new-session -d -s "$name" -c "$dir" "$cmd" ||
    { printf 'erro%sfalhou criar a sessao tmux\n' "$SEP"; return 1; }
  tmux set-option -t "$name" @work_agent "$agent" 2>/dev/null
  printf 'ok%s%s\n' "$SEP" "$name"
}

raw_for_host() {
  local i="$1"
  if is_self "$i"; then ls_raw; return; fi
  # shellcheck disable=SC2046  # o prefixo e varios tokens, sem espaco interno
  ssh -n "${SSH_BATCH[@]}" "${TARGETS[$i]}" $(remote_prefix "$i") ls-raw 2>/dev/null | tr -d '\r'
}

R_HOST=(); R_SESSION=(); R_WIN=(); R_AGE=(); R_ATTACHED=(); R_AGENT=(); R_PATH=(); R_IDX=()

age_of() {
  local created="$1" now delta
  now=$(date +%s 2>/dev/null) || { printf '?'; return; }
  case "$created" in ''|*[!0-9]*) printf '?'; return ;; esac
  delta=$((now - created))
  [ "$delta" -lt 0 ] && delta=0
  if   [ "$delta" -lt 3600 ];  then printf '%dm' "$((delta / 60))"
  elif [ "$delta" -lt 86400 ]; then printf '%dh' "$((delta / 3600))"
  else                              printf '%dd' "$((delta / 86400))"; fi
}

H_STATUS=(); H_OUTSIDE=(); H_SESSIONS=()

collect_sessions() {
  R_HOST=(); R_SESSION=(); R_WIN=(); R_AGE=(); R_ATTACHED=(); R_AGENT=(); R_PATH=(); R_IDX=()
  H_STATUS=(); H_OUTSIDE=(); H_SESSIONS=()
  local tmp i s w c a ag p
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/work.XXXXXX") || die "nao consegui criar diretorio temporario"
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    raw_for_host "$i" > "$tmp/$i" 2>/dev/null &
  done
  wait
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    # A linha "#fora" fecha a resposta: se ela nao veio, a maquina nao
    # respondeu (ssh caiu, ou o `work` de la e velho demais). Sem isso, maquina
    # muda e maquina vazia ficam indistinguiveis -- e voce procura uma sessao
    # que a lista nunca ia mostrar.
    H_STATUS+=("sem-resposta"); H_OUTSIDE+=(0); H_SESSIONS+=(0)
    [ -s "$tmp/$i" ] || continue
    while IFS="$SEP" read -r s w c a ag p; do
      [ -n "$s" ] || continue
      if [ "$s" = "#fora" ]; then
        H_STATUS[$i]="ok"; H_OUTSIDE[$i]="${w:-0}"
        continue
      fi
      R_HOST+=("${NAMES[$i]}"); R_IDX+=("$i")
      R_SESSION+=("$s"); R_WIN+=("$w"); R_AGE+=("$(age_of "$c")")
      R_ATTACHED+=("$a"); R_AGENT+=("${ag:--}"); R_PATH+=("$p")
      H_SESSIONS[$i]=$(( ${H_SESSIONS[$i]} + 1 ))
    done < "$tmp/$i"
  done
  rm -rf "$tmp"
}

# O que a tabela de sessoes nao mostra: maquina que nao respondeu e agente
# rodando solto, fora do tmux.
render_footer() {
  local i mudas="" fora="" com=0 sem=0 nao=0 deduzido=0
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    if [ "${H_STATUS[$i]}" != "ok" ]; then
      nao=$((nao + 1)); mudas="$mudas${mudas:+, }${NAMES[$i]}"
      continue
    fi
    if [ "${H_SESSIONS[$i]}" -gt 0 ]; then com=$((com + 1)); else sem=$((sem + 1)); fi
    [ "${H_OUTSIDE[$i]}" -gt 0 ] 2>/dev/null &&
      fora="$fora${fora:+, }${NAMES[$i]} (${H_OUTSIDE[$i]})"
  done
  for ((i = 0; i < ${#R_AGENT[@]}; i++)); do
    case "${R_AGENT[$i]}" in *'~') deduzido=1 ;; esac
  done
  [ "${deduzido:-0}" = 1 ] &&
    printf '\n~ = agente deduzido do processo (sessao nao criada pelo work)\n'
  printf '\n%d maquinas: %d com sessao, %d sem' "${#NAMES[@]}" "$com" "$sem"
  [ "$nao" -gt 0 ] && printf ', %d sem resposta: %s  ->  %s doctor' "$nao" "$mudas" "$PROG"
  printf '\n'
  [ -n "$fora" ] && printf 'agente fora do tmux, aberto direto (nao da para atachar): %s\n' "$fora"
  return 0
}

render_rows() {
  local i wh=7 ws=6 n
  for ((i = 0; i < ${#R_HOST[@]}; i++)); do
    n=${#R_HOST[$i]};    [ "$n" -gt "$wh" ] && wh=$n
    n=${#R_SESSION[$i]}; [ "$n" -gt "$ws" ] && ws=$n
  done
  printf '%3s  %-*s  %-*s  %-8s  %3s  %5s  %s\n' \
    '#' "$wh" MAQUINA "$ws" SESSAO AGENTE JAN IDADE ''
  for ((i = 0; i < ${#R_HOST[@]}; i++)); do
    printf '%3d  %-*s  %-*s  %-8s  %3s  %5s  %s\n' \
      "$((i + 1))" "$wh" "${R_HOST[$i]}" "$ws" "${R_SESSION[$i]}" \
      "${R_AGENT[$i]}" "${R_WIN[$i]}" "${R_AGE[$i]}" \
      "$([ "${R_ATTACHED[$i]}" = 1 ] && printf 'anexada' || printf '')"
  done
}

# ----------------------------------------------------------------- acoes --

do_attach_local() {
  local s="$1" err
  # O erro do tmux vai junto: engolido, "nao existe" tambem seria o que se ve
  # quando o tmux nao esta no PATH ou o servidor caiu -- causas bem diferentes.
  err=$(tmux has-session -t "=$s" 2>&1) ||
    die "nao achei a sessao '$s' nesta maquina (tmux: ${err:-sem detalhe})"
  tmux_clipboard
  if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "=$s"; fi
  # -d expulsa os outros clientes. Util quando a sessao esta atachada noutra
  # maquina: com dois clientes, o tmux encolhe a janela para o menor dos dois
  # e a vista do maior fica truncada, parecendo que "nao abriu".
  exec tmux attach ${ATTACH_DETACH:+-d} -t "=$s"
}

# Attach numa outra maquina. Sem `exec`: se falhar, precisa sobrar alguem para
# dizer o motivo -- senao volta ao prompt em silencio.
remote_attach() {
  local i="$1" s="$2" rc
  # shellcheck disable=SC2046
  ssh "${SSH_TTY[@]}" "${TARGETS[$i]}" $(remote_prefix "$i") attach ${ATTACH_DETACH:+-d} "$s"
  rc=$?
  [ "$rc" -eq 0 ] || die "attach de '$s' em ${NAMES[$i]} terminou com rc=$rc"
  exit 0
}

attach_index() {
  local r="$1" i s
  i="${R_IDX[$r]}"; s="${R_SESSION[$r]}"
  if is_self "$i"; then do_attach_local "$s"; fi
  remote_attach "$i" "$s"
}

create_session() {
  local i="$1" task="$2" repo="$3" agent="$4" top
  valid_slug "$task" || die "nome de tarefa deve ser slug [A-Za-z0-9._-]: $task"
  [ -n "$repo" ] && { valid_repo "$repo" || die "repo com caractere inseguro (use nome, /c/dev/x ou C:/dev/x): $repo"; }

  if is_self "$i"; then
    if [ -z "$repo" ]; then
      top=$(git rev-parse --show-toplevel 2>/dev/null) && repo="$top"
    fi
    exec work-session --agent "$agent" ${prompt:+--prompt "$prompt"} "$task" ${repo:+"$repo"}
  fi

  # Remoto: o diretorio atual nao viaja, mas o *nome* do repo sim -- a maquina
  # de la resolve na copia dela.
  if [ -z "$repo" ]; then
    top=$(git rev-parse --show-toplevel 2>/dev/null) && repo=$(basename "$top")
    [ -n "$repo" ] && valid_repo "$repo" || repo=""
  fi
  # shellcheck disable=SC2046
  # O ssh junta os argumentos numa linha para o shell de la: o prompt vai citado.
  exec ssh "${SSH_TTY[@]}" "${TARGETS[$i]}" $(remote_prefix "$i") run --agent "$agent" \
    ${prompt:+--prompt "$(printf '%q' "$prompt")"} "$task" ${repo:+"$repo"}
}

menu() {
  collect_sessions
  if [ "${#R_HOST[@]}" -eq 0 ]; then
    if [ "${#NAMES[@]}" -eq 0 ]; then
      printf 'nenhuma maquina registrada. comece com: %s hosts discover\n' "$PROG"
      return 1
    fi
    printf 'nenhuma sessao viva em %d maquina(s): %s\n' "${#NAMES[@]}" "$(list_names)"
    printf 'crie uma com: %s <tarefa> [repo]  |  %s <maquina> <tarefa> [repo]\n' "$PROG" "$PROG"
    render_footer
    return 0
  fi
  if [ ! -t 0 ] || [ ! -t 1 ]; then render_rows; render_footer; return 0; fi

  local choice=""
  if command -v fzf >/dev/null 2>&1 && [ "${WORK_MENU:-}" != plain ]; then
    render_footer
    choice=$(render_rows | fzf --header-lines=1 --height=40% --reverse \
      --prompt='sessao> ' --no-multi | awk '{print $1}')
    [ -n "$choice" ] || return 0
  else
    render_rows
    render_footer
    printf '\nsessao (numero, nome ou q): '
    read -r choice < /dev/tty || return 0
  fi

  case "$choice" in
    ''|q|Q) return 0 ;;
    *[!0-9]*)
      local i
      for ((i = 0; i < ${#R_SESSION[@]}; i++)); do
        [ "${R_SESSION[$i]}" = "$choice" ] && attach_index "$i"
      done
      die "sessao '$choice' nao esta na lista" ;;
    *)
      [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "${#R_SESSION[@]}" ] \
        || die "escolha fora da lista: $choice"
      attach_index "$((choice - 1))" ;;
  esac
}

# ------------------------------------------------------- adocao (cliente) --

A_HOST=(); A_IDX=(); A_PID=(); A_AGENT=(); A_DIR=(); A_AGE=(); A_CONV=()

collect_adoptables() {
  A_HOST=(); A_IDX=(); A_PID=(); A_AGENT=(); A_DIR=(); A_AGE=(); A_CONV=()
  local only="$1" tmp i pid ag dir ep cid
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/workad.XXXXXX") || die "nao consegui criar diretorio temporario"
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    [ -n "$only" ] && [ "$only" != "$i" ] && continue
    if is_self "$i"; then
      adopt_list > "$tmp/$i" 2>/dev/null &
    else
      # shellcheck disable=SC2046
      ssh -n "${SSH_BATCH[@]}" "${TARGETS[$i]}" $(remote_prefix "$i") adopt-list > "$tmp/$i" 2>/dev/null &
    fi
  done
  wait
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    [ -s "$tmp/$i" ] || continue
    while IFS="$SEP" read -r pid ag dir ep cid; do
      case "$pid" in ''|*[!0-9]*) continue ;; esac
      A_HOST+=("${NAMES[$i]}"); A_IDX+=("$i"); A_PID+=("$pid"); A_AGENT+=("$ag")
      A_DIR+=("$dir"); A_AGE+=("$(age_of "$ep")")
      # Conversa exata quando o pid carrega o id; senao, a mais recente do dir.
      A_CONV+=("$([ -n "$cid" ] && printf '%s' "${cid%%-*}" || printf '+recente')")
    done < <(tr -d '\r' < "$tmp/$i")
  done
  rm -rf "$tmp"
}

cmd_adopt() {
  local target="${1:-}" only="" i idx choice conf out name
  if [ -n "$target" ]; then
    only=$(resolve_host "$target") || die "maquina desconhecida: $target (veja: $PROG hosts)"
  fi
  collect_adoptables "$only"
  if [ "${#A_PID[@]}" -eq 0 ]; then
    printf 'nenhum agente rodando fora do tmux%s\n' "${target:+ em $target}"
    return 0
  fi

  printf '%3s  %-16s  %-7s  %5s  %-9s  %s\n' '#' MAQUINA AGENTE ATIVO CONVERSA DIRETORIO
  for ((i = 0; i < ${#A_PID[@]}; i++)); do
    printf '%3d  %-16s  %-7s  %5s  %-9s  %s\n' \
      "$((i + 1))" "${A_HOST[$i]}" "${A_AGENT[$i]}" "${A_AGE[$i]}" \
      "${A_CONV[$i]}" "${A_DIR[$i]}"
  done
  printf '\nadotar = ENCERRAR o processo e reabrir a mesma conversa dentro do tmux.\n'
  printf 'perde o turno em andamento e o scrollback; a conversa volta pelo --continue.\n'

  [ -t 0 ] && [ -t 1 ] || return 0
  printf '\nqual adotar? (numero, q): '
  read -r choice < /dev/tty || return 0
  case "$choice" in
    ''|q|Q)   return 0 ;;
    *[!0-9]*) die "escolha invalida: $choice" ;;
  esac
  [ "$choice" -ge 1 ] && [ "$choice" -le "${#A_PID[@]}" ] || die "fora da lista: $choice"
  i=$((choice - 1)); idx="${A_IDX[$i]}"

  printf 'encerrar %s (pid %s) em %s e reabrir em tmux? [s/N] ' \
    "${A_AGENT[$i]}" "${A_PID[$i]}" "${A_HOST[$i]}"
  read -r conf < /dev/tty || return 0
  case "$conf" in s|S|y|Y) ;; *) printf 'cancelado\n'; return 0 ;; esac

  if is_self "$idx"; then
    out=$(adopt_do "${A_PID[$i]}")
  else
    # shellcheck disable=SC2046
    out=$(ssh -n "${SSH_BATCH[@]}" "${TARGETS[$idx]}" $(remote_prefix "$idx") adopt-do "${A_PID[$i]}" 2>&1 |
          tr -d '\r' | grep -E '^(ok|erro)' | head -1)
  fi
  case "$out" in
    ok*) name=${out#ok${SEP}}
         printf 'adotada: sessao %s em %s\n' "$name" "${A_HOST[$i]}"
         if is_self "$idx"; then do_attach_local "$name"; fi
         remote_attach "$idx" "$name" ;;
    erro*) die "${out#erro${SEP}}" ;;
    *)     die "sem resposta de ${A_HOST[$i]}" ;;
  esac
}

list_names() {
  local i out=""
  for ((i = 0; i < ${#NAMES[@]}; i++)); do out="$out${out:+, }${NAMES[$i]}"; done
  printf '%s' "$out"
}

# ------------------------------------------------------------------ hosts --

hosts_show() {
  local i mark
  printf '%-18s  %-28s  %-6s  %s\n' MAQUINA DESTINO-SSH TIPO ''
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    mark=""; [ "${NAMES[$i]}" = "$SELF" ] && mark="<- esta maquina"
    printf '%-18s  %-28s  %-6s  %s\n' "${NAMES[$i]}" "${TARGETS[$i]}" "${KINDS[$i]}" "$mark"
  done
  printf '\nregistro: %s\n' "$CONFIG"
}

config_init() {
  mkdir -p "$(dirname "$CONFIG")"
  [ -f "$CONFIG" ] && return 0
  cat > "$CONFIG" <<'EOF'
# Maquinas onde o `work` pode criar/atachar sessao.
# Nome = nome oficial da maquina no tailnet.
#
#   host <nome-tailnet> <user@host-ssh> <posix|msys>
#   self <nome-tailnet>        qual dessas e esta maquina aqui
#
# `work hosts discover` preenche a partir do `tailscale status`.
EOF
}

hosts_add() {
  local name="$1" target="$2" kind="${3:-posix}"
  valid_slug "$name" || die "nome de maquina invalido: $name"
  config_init
  if resolve_host "$name" >/dev/null 2>&1; then
    warn "$name ja esta no registro"; return 0
  fi
  printf 'host %s %s %s\n' "$name" "$target" "$kind" >> "$CONFIG"
  printf 'registrado: %s -> %s (%s)\n' "$name" "$target" "$kind"
}

hosts_rm() {
  local name="$1" tmp
  [ -f "$CONFIG" ] || die "sem registro em $CONFIG"
  tmp="$CONFIG.tmp.$$"
  { grep -v -E "^host[[:space:]]+${name}([[:space:]]|\$)" "$CONFIG" || true; } > "$tmp"
  mv "$tmp" "$CONFIG"
  printf 'removido: %s\n' "$name"
}

hosts_self() {
  local name="$1" tmp
  config_init
  tmp="$CONFIG.tmp.$$"
  { grep -v -E '^self[[:space:]]' "$CONFIG" || true; } > "$tmp"
  mv "$tmp" "$CONFIG"
  printf 'self %s\n' "$name" >> "$CONFIG"
  printf 'esta maquina e: %s\n' "$name"
}

# Usuario ssh de um host: o que o ~/.ssh/config disser, senao o usuario local.
ssh_user_for() {
  local h="$1" u
  u=$(ssh -G "$h" 2>/dev/null | awk '$1 == "user" { print $2; exit }')
  printf '%s' "${u:-${USER:-$(id -un 2>/dev/null)}}"
}

hosts_discover() {
  local rows name os kind user added=0 self_tn
  rows=$(tailnet_rows) || die "tailscale nao encontrado; registre a mao com: $PROG hosts add <nome> <user@host> [posix|msys]"
  config_init
  while IFS="$TAB" read -r name os; do
    [ -n "$name" ] || continue
    case "$os" in
      iOS|android|tvOS) continue ;;
      windows) kind=msys ;;
      *)       kind=posix ;;
    esac
    load_config
    resolve_host "$name" >/dev/null 2>&1 && continue
    user=$(ssh_user_for "$name")
    printf 'host %s %s@%s %s\n' "$name" "$user" "$name" "$kind" >> "$CONFIG"
    printf 'registrado: %-18s %s@%s (%s, %s)\n' "$name" "$user" "$name" "$kind" "$os"
    added=$((added + 1))
  done <<EOF
$rows
EOF
  [ "$added" -eq 0 ] && printf 'nada novo: todas as maquinas do tailnet ja estao no registro\n'
  load_config
  self_tn=$(tailnet_self 2>/dev/null)
  [ -n "$self_tn" ] && [ -z "$SELF_NAME" ] && hosts_self "$self_tn"
  return 0
}

# ----------------------------------------------------------------- doctor --

# Quem sabe o PATH real desta maquina e o work-session (ele e que monta os
# diretorios do lado Windows e os shims do mise): o probe e dele.
probe_local() {
  command -v work-session >/dev/null 2>&1 || { printf 'work=NAO\n'; return; }
  work-session --probe
}

doctor() {
  local i out rc
  printf 'registro: %s\nesta maquina: %s\n\n' "$CONFIG" "${SELF:-<nao identificada>}"
  for ((i = 0; i < ${#NAMES[@]}; i++)); do
    printf '== %-18s %s\n' "${NAMES[$i]}" "${TARGETS[$i]}"
    if is_self "$i"; then
      printf '   local      %s\n' "$(probe_local)"
      continue
    fi
    out=$(ssh -n "${SSH_BATCH[@]}" "${TARGETS[$i]}" $(remote_prefix "$i") probe 2>&1 | tr -d '\r' | grep -E '^work=' | head -1)
    rc=$?
    if [ -n "$out" ]; then
      printf '   ssh ok     %s\n' "$out"
    else
      printf '   FALHOU     ssh ou `work` indisponivel (rc=%s); veja se a chave desta maquina esta autorizada no alvo e se o work esta instalado la\n' "$rc"
    fi
  done
  # Sessoes do agente local nao entram aqui: doctor e sobre alcance, nao carga.
}

# O cabecalho deste arquivo e a ajuda: imprime do comentario da linha 2 ate a
# primeira linha que nao e comentario.
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

# ------------------------------------------------------------------- main --

load_config
SELF=$(detect_self || true)

agent="${WORK_AGENT:-claude}"
prompt=""
ATTACH_DETACH=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -a|--agent) agent="${2:-}"; shift 2 || die "faltou o nome do agente" ;;
    --claude) agent=claude; shift ;;
    --codex)  agent=codex;  shift ;;
    --shell)  agent=shell;  shift ;;
    -p|--prompt) prompt=$(printf '%s' "${2:-}" | tr '\n' ' '); shift 2 || die "faltou o texto do prompt" ;;
    -d|--detach-others) ATTACH_DETACH=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do args+=("$1"); shift; done ;;
    -*) die "opcao desconhecida: $1" ;;
    *) args+=("$1"); shift ;;
  esac
done

set -- ${args[@]+"${args[@]}"}

case "${1:-}" in
  '')        menu; exit $? ;;
  ls)        collect_sessions
             if [ "${#R_HOST[@]}" -eq 0 ]; then
               [ "${#NAMES[@]}" -eq 0 ] && die "nenhuma maquina registrada; comece com: $PROG hosts discover"
               printf 'nenhuma sessao viva em: %s\n' "$(list_names)"
             else
               render_rows
             fi
             render_footer
             exit 0 ;;
  adopt)     shift; cmd_adopt "${1:-}"; exit $? ;;
  ls-raw)    ls_raw; exit 0 ;;          # uso interno, via ssh
  probe)     probe_local; exit 0 ;;     # uso interno, via ssh
  adopt-list) adopt_list; exit 0 ;;     # uso interno, via ssh
  adopt-do)  shift; adopt_do "${1:-}"; exit $? ;;   # uso interno, via ssh
  run)       shift                      # uso interno: cria nesta maquina
             exec work-session --agent "$agent" ${prompt:+--prompt "$prompt"} "$@" ;;
  attach)
    shift
    sess="${1:-}"; hostarg="${2:-}"
    [ -n "$sess" ] || die "usage: $PROG attach <sessao> [maquina]"
    if [ -n "$hostarg" ]; then
      idx=$(resolve_host "$hostarg") || die "maquina desconhecida: $hostarg (veja: $PROG hosts)"
      if is_self "$idx"; then do_attach_local "$sess"; fi
      remote_attach "$idx" "$sess"
    fi
    # Atalho que importa: quando o `work` de outra maquina chama este por ssh,
    # a sessao esta aqui. Atachar direto evita uma varredura de rede inteira
    # (com o timeout de cada maquina) so para redescobrir o obvio.
    tmux has-session -t "=$sess" 2>/dev/null && do_attach_local "$sess"
    # Senao, procura em todas e so entao decide.
    collect_sessions
    for ((i = 0; i < ${#R_SESSION[@]}; i++)); do
      [ "${R_SESSION[$i]}" = "$sess" ] && attach_index "$i"
    done
    die "sessao '$sess' nao existe em nenhuma maquina registrada" ;;
  hosts)
    shift
    case "${1:-}" in
      ''|show|list) hosts_show ;;
      discover)     hosts_discover ;;
      add)          shift; [ $# -ge 2 ] || die "usage: $PROG hosts add <nome> <user@host> [posix|msys]"
                    hosts_add "$@" ;;
      rm|remove)    shift; [ $# -ge 1 ] || die "usage: $PROG hosts rm <nome>"; hosts_rm "$1" ;;
      self)         shift; [ $# -ge 1 ] || die "usage: $PROG hosts self <nome>"; hosts_self "$1" ;;
      *)            die "subcomando de hosts desconhecido: $1" ;;
    esac
    exit 0 ;;
  doctor)    doctor; exit 0 ;;
  version)   printf 'work (tmux work sessions) %s\n' "${WORK_VERSION:-2.0}"; exit 0 ;;
  help)      usage; exit 0 ;;
esac

# Sobrou: `work <tarefa> [repo]` ou `work <maquina> <tarefa> [repo]`.
#
# Antes disso, uma protecao: numa maquina com `work` antigo, um subcomando que
# ela ainda nao conhece cairia aqui e viraria *nome de tarefa*. Melhor dizer
# que a versao esta velha do que criar uma branch chamada "adopt-list".
case "${1:-}" in
  ls-*|adopt*|probe|run|hosts|doctor|attach|version|help)
    die "subcomando '$1' nao existe nesta versao do work (atualize com: scripts/deploy.sh)" ;;
esac
[ -n "$SELF" ] || warn "nao identifiquei esta maquina no registro; use: $PROG hosts self <nome>"

if [ $# -ge 2 ] && idx=$(resolve_host "$1" 2>/dev/null); then
  shift
  create_session "$idx" "${1:-}" "${2:-}" "$agent"
fi

if [ -n "$SELF" ]; then
  selfidx=$(resolve_host "$SELF") || die "registro nao tem a maquina '$SELF'"
  create_session "$selfidx" "${1:-}" "${2:-}" "$agent"
fi

# Sem registro utilizavel: ainda da para trabalhar local.
valid_slug "${1:-}" || die "nome de tarefa deve ser slug [A-Za-z0-9._-]: ${1:-}"
repo="${2:-}"
[ -z "$repo" ] && repo=$(git rev-parse --show-toplevel 2>/dev/null)
exec work-session --agent "$agent" ${prompt:+--prompt "$prompt"} "$1" ${repo:+"$repo"}
