#!/usr/bin/env bash
# work-session <nome-da-tarefa> [repo]
#
# Atacha na sessao tmux da tarefa; se nao existir, cria um worktree irmao do repo
# (fora do diretorio principal), a sessao tmux e sobe o claude la dentro.
#
# repo: caminho de um repo git (aceita C:\... ou /c/...), ou nome de diretorio
#       dentro de $WORK_REPOS_DIR. So e necessario quando a sessao nao existe.
#
# Porte do ~/.local/bin/work-session do mac. Quatro diferencas que o Windows impoe:
#
#   1. O PATH do login shell do MSYS2 e minimo e nao ve git/node/claude, que
#      moram do lado Windows; por isso os diretorios entram a mao aqui.
#   2. O claude e um .exe nativo: dentro do pane do tmux ele so ganha um console
#      de verdade (raw mode, TUI) atraves do winpty.
#   3. $repo-$task pode colidir com um repo vizinho de verdade (coreum ->
#      coreum-docs, coreum-edge-poc ja existem), entao um diretorio preexistente
#      so e reaproveitado se for mesmo um worktree deste repo.
#   4. Todo worktree e um diretorio novo, e o claude para no dialogo de confianca
#      esperando um Enter -- o que anula a sessao autonoma se voce saiu de perto.
#      Como o worktree e um checkout do repo que voce mesmo escolheu, ele ja
#      entra confiado. WORK_NO_AUTOTRUST=1 desliga.

set -euo pipefail

for dir in \
  "/c/Program Files/Git/cmd" \
  "/c/Program Files/nodejs" \
  "$HOME/AppData/Local/Microsoft/WinGet/Links" \
  "/c/Program Files/GitHub CLI" \
  "$HOME/.local/bin"
do
  [[ -d "$dir" ]] && PATH="$PATH:$dir"
done
export PATH
export TERM="${TERM:-xterm-256color}"

task="${1:-}"
repo_arg="${2:-}"
repos_dir="${WORK_REPOS_DIR:-/c/dev}"

die() { printf 'work-session: %s\n' "$*" >&2; exit 1; }

[[ -n "$task" ]] || die "usage: work-session <nome-da-tarefa> [repo]"

# Uma sessao viva ganha de tudo: reatacha e pronto.
session=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -E -- "(^|-)${task}\$" | head -1 || true)
if [[ -n "$session" ]]; then
  exec tmux attach -t "$session"
fi

if [[ -z "$repo_arg" ]]; then
  printf "work-session: nenhuma sessao para '%s'; informe o repo para criar uma\n" "$task" >&2
  printf 'repos em %s:\n' "$repos_dir" >&2
  ls -1 "$repos_dir" >&2
  exit 1
fi

# PowerShell entrega C:\dev\coreum; o tmux e o git precisam de /c/dev/coreum.
to_unix() { cygpath -u "$1" 2>/dev/null || printf '%s' "$1"; }
repo_arg=$(to_unix "$repo_arg")

if git -C "$repo_arg" rev-parse --show-toplevel &>/dev/null; then
  repo_root=$(git -C "$repo_arg" rev-parse --show-toplevel)
elif git -C "${repos_dir}/${repo_arg}" rev-parse --show-toplevel &>/dev/null; then
  repo_root=$(git -C "${repos_dir}/${repo_arg}" rev-parse --show-toplevel)
else
  die "'$repo_arg' nao e um repo git"
fi

repo_root=$(to_unix "$repo_root")
repo_name=$(basename "$repo_root")
worktree_path="${repo_root}-${task}"
branch="work/${task}"
session="${repo_name}-${task}"

git_common() { git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true; }

if [[ -e "$worktree_path" ]]; then
  if [[ "$(git_common "$worktree_path")" != "$(git_common "$repo_root")" ]]; then
    die "$worktree_path ja existe e nao e um worktree de ${repo_name}; escolha outro nome de tarefa"
  fi
elif git -C "$repo_root" show-ref --verify --quiet "refs/heads/${branch}"; then
  git -C "$repo_root" worktree add "$worktree_path" "$branch"
else
  git -C "$repo_root" worktree add "$worktree_path" -b "$branch"
fi

# O claude indexa projeto por caminho no formato C:/dev/... (o mesmo do cygpath -m).
# Escrita em tmp + rename para o ~/.claude.json nunca ficar truncado no meio.
if [[ "${WORK_NO_AUTOTRUST:-0}" != "1" ]]; then
  node -e '
    const fs = require("fs"), os = require("os"), path = require("path");
    const file = path.join(os.homedir(), ".claude.json");
    let data;
    try { data = JSON.parse(fs.readFileSync(file, "utf8")); }
    catch (e) { process.exit(0); }
    if (!fs.existsSync(file + ".pre-work-session.bak")) {
      fs.copyFileSync(file, file + ".pre-work-session.bak");
    }
    data.projects = data.projects || {};
    data.projects[process.argv[1]] = Object.assign(
      {}, data.projects[process.argv[1]], { hasTrustDialogAccepted: true }
    );
    const tmp = file + ".work-session.tmp";
    fs.writeFileSync(tmp, JSON.stringify(data, null, 2));
    fs.renameSync(tmp, file);
  ' "$(cygpath -m "$worktree_path")" || true
fi

claude_bin=$(command -v claude) || die "claude nao encontrado no PATH"

exec tmux new-session -s "$session" -c "$worktree_path" \
  "winpty $(printf '%q' "$claude_bin") --dangerously-skip-permissions --name $(printf '%q' "$task")"
